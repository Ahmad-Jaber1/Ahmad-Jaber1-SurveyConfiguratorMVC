@using SurveyWeb.Resources;
@using SurveyConfiguratorTask.Models;
@model Shared.Result<List<SurveyConfiguratorTask.Models.Question>>
@{

    ViewBag.Title = "Home Page";
    const string QUESTION_TYPE = "Question Type";
    const string QUESTION_TEXT = "Question Text";
    const string QUESTION_ORDER = "Question Order";
    const string ACTIONS = "Actions";
    const string EDIT_BUTTON = "Edit";
    const string EDIT_ACTION = "Edit";

    const string DELETE_BUTTON = "Delete";
    const string DELETE_ACTION = "ConfirmDeletion";

    const string ADD_BUTTON = "Add";

}


<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@Resources.QUESTIONS</h5>
        @Html.ActionLink(Resources.ADD_BUTTON, "Add", "Question", new { }, htmlAttributes: new { @class = "btn btn-info" })

    </div>

    <div class="card-body" id="questionsTableContainer">
        @Html.Partial("_QuestionsList", Model)
    </div>
</div>

@section scripts {
    <script>
        
        const connection = $.hubConnection();
        const hub = connection.createHubProxy("questionHub");

       
        hub.on("refreshQuestions", function () {
            
            reloadQuestionsTable();
        });

        // 3. Start connection
        connection.start().done();

         
        function reloadQuestionsTable() {
            $.ajax({
                url: '/Question/GetQuestionsPartial', 
                type: 'GET',
                success: function (html) {
                    $('#questionsTableContainer').html(html);
                }
            });
        }
    </script>
}