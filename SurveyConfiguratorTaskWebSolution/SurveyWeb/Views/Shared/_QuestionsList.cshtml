@using SurveyWeb.Resources;
@using SurveyConfiguratorTask.Models;
@model Shared.Result<List<SurveyConfiguratorTask.Models.Question>>

<table class="table table-hover table-bordered">
    <thead class="thead-dark">
        <tr>
            <th>@Resources.QUESTION_TEXT</th>
            <th>@Resources.QUESTION_ORDER</th>
            <th>@Resources.QUESTION_TYPE</th>
            <th>@Resources.ACTIONS</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Question question in Model.Data)
        {
            <tr>
                <td>@question.Text</td>
                <td>@question.Order</td>
                <td>
                    @switch (question.TypeQuestion)
                    {
                        case TypeQuestionEnum.SliderQuestion:
                            @Resources.SLIDER_QUESTION
                            break;
                        case TypeQuestionEnum.SmileyFacesQuestion:
                            @Resources.SMILEY_QUESTION
                            break;
                        case TypeQuestionEnum.StarsQuestion:
                            @Resources.STARS_QUESTION
                            break;
                    }
                </td>
                <td>
                    @Html.ActionLink(Resources.EDIT_BUTTON, "Edit", "Question", new { question.Id }, new { @class = "btn btn-info" })

                    @Html.ActionLink(Resources.DELETE_BUTTON, "ConfirmDeletion", "Question", new { question.Id }, new { @class = "btn btn-danger" })
                </td>
            </tr>
        }
    </tbody>
</table>